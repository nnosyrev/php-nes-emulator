#!/usr/bin/env php
<?php

use App\PPU\Frame;
use App\Rom\Rom;
use Serafim\SDL\Event\Type;
use Serafim\SDL\SDL;

require_once __DIR__ . '/vendor/autoload.php';

const SQUARE_WIDTH = 3;
const WINDOW_WIDTH = Frame::WIDTH * SQUARE_WIDTH;
const WINDOW_HEIGHT = Frame::HEIGHT * SQUARE_WIDTH;

$pallete = [
    2, 10, 32, 14
];

function getFrame(array $chrRom, int $bank, array $pallete): Frame
{
    if ($bank > 1 || $bank < 0) {
        throw new \Exception('Incorrect bank');
    }

    $bankStart = $bank * 0x1000;

    $frame = new Frame(0);

    foreach (\range(0, 255) as $tileN) {
        if ($tileN != 251) {
            //continue;
        }
        $tile = \array_slice($chrRom, $bankStart + $tileN * 16, 16);

        $baseX = ($tileN % 32) * 8;
        $baseY = \floor($tileN / 32) * 8;

        foreach (\range(0, 7) as $y) {
            $upper = $tile[$y];
            $lower = $tile[$y + 8];

            foreach (\range(7, 0) as $x) {
                $value = (1 & $lower) << 1 | (1 & $upper);
                $upper = $upper >> 1;
                $lower = $lower >> 1;

                $frame->setPixel($baseX + $x, $baseY + $y, $pallete[$value]);
            }
        }
    }

    return $frame;
}

$file = \file_get_contents($argv[1]);
$rom = new Rom($file);

$frame = getFrame($rom->getChrRom(), 0, $pallete);

// Init
$sdl = new SDL();

$event = $sdl->new('SDL_Event');
$pixels = $sdl->new('int *');
$pitch = $sdl->new('int');

$window = $sdl->SDL_CreateWindow(
    'NES emulator',
    SDL::SDL_WINDOWPOS_UNDEFINED,
    SDL::SDL_WINDOWPOS_UNDEFINED,
    WINDOW_WIDTH,
    WINDOW_HEIGHT,
    SDL::SDL_WINDOW_SHOWN
);

$renderer = $sdl->SDL_CreateRenderer($window, 0, SDL::SDL_RENDERER_ACCELERATED);

$texture = $sdl->SDL_CreateTexture(
    $renderer,
    SDL::SDL_PIXELFORMAT_RGBA32,
    SDL::SDL_TEXTUREACCESS_STREAMING,
    Frame::WIDTH,
    Frame::HEIGHT
);


// Clear screen
$sdl->SDL_SetRenderDrawColor($renderer, 100, 0, 0, 0);
$sdl->SDL_RenderClear($renderer);

if (0 == $sdl->SDL_LockTexture($texture, null, $sdl->cast('void**', \FFI::addr($pixels)), \FFI::addr($pitch))) {
    foreach ($frame->getPixels() as $key => $value) {
        $pixels[$key] = $value;
    }

    $sdl->SDL_UnlockTexture($texture);
}

$sdl->SDL_RenderCopy($renderer, $texture, null, null);

$sdl->SDL_RenderPresent($renderer);

// Wait for quit event
while (true) {
    if ($sdl->SDL_PollEvent(\FFI::addr($event))) {
        if ($event->type == Type::SDL_QUIT) {
            break;
        } elseif ($event->type == Type::SDL_KEYDOWN) {
            $symChar = \chr($event->key->keysym->sym);
            if ($symChar == 'q') {
                break;
            }
        }
    }
}

// Destroy
$sdl->SDL_DestroyTexture($texture);
$sdl->SDL_DestroyRenderer($renderer);
$sdl->SDL_DestroyWindow($window);
$sdl->SDL_Quit();
